{
  "name": "isa-auth-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "yarn --cwd packages/core build && yarn --cwd packages/core type",
    "build:auth": "yarn --cwd packages/isa-auth build",
    "build:server": "yarn --cwd packages/server build",
    "build:mcp": "yarn --cwd packages/mcp build",
    "build": "yarn build:core && yarn build:auth && yarn build:server && yarn build:mcp",
    "test:integration": "node tests/integration.test.js",
    "test:server": "node tests/server.test.js",
    "test:mcp": "node tests/mcp.test.js",
    "test": "node scripts/run-tests.js",
    "demo": "node packages/demo/server.js",
    "app": "node examples/dashboard-app/server.js",
    "build:demo": "yarn build && node scripts/build-demo.js",
    "deploy:demo": "yarn build:demo && node scripts/deploy-gh-pages.js"
  },
  "dependencies": {},
  "devDependencies": {
    "lerna": "^8.1.8"
  }
}
