# ==============================================================================
# ISA-AUTH Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your developer console credentials.
# Vite prefixes (VITE_*) and Next.js prefixes (NEXT_PUBLIC_*) are supported.

# ------------------------------------------------------------------------------
# 1. Social & Portals Providers
# ------------------------------------------------------------------------------
# Google Identity Services (https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In (https://developer.apple.com/account/resources/identifiers/list)
VITE_APPLE_CLIENT_ID=com.yourcompany.service
VITE_APPLE_REDIRECT_URI=https://yourdomain.com/auth/apple/callback

# Meta / Facebook Login (https://developers.facebook.com/apps)
VITE_META_APP_ID=123456789012345
VITE_META_REDIRECT_URI=https://yourdomain.com/auth/meta/callback

# Kakao Developers (https://developers.kakao.com/console/app)
VITE_KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key
VITE_KAKAO_REDIRECT_URI=https://yourdomain.com/auth/kakao/callback

# Naver Developers (https://developers.naver.com/apps/#/register)
VITE_NAVER_CLIENT_ID=your_naver_client_id
VITE_NAVER_CALLBACK_URL=https://yourdomain.com/auth/naver/callback

# LINE Developers (https://developers.line.biz/console/)
VITE_LINE_CHANNEL_ID=your_line_channel_id
VITE_LINE_CALLBACK_URL=https://yourdomain.com/auth/line/callback

# ------------------------------------------------------------------------------
# 2. Developer & Community Providers
# ------------------------------------------------------------------------------
# GitHub OAuth App (https://github.com/settings/developers)
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_REDIRECT_URI=https://yourdomain.com/auth/github/callback

# Discord Developer Portal (https://discord.com/developers/applications)
VITE_DISCORD_CLIENT_ID=your_discord_client_id
VITE_DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback

# ------------------------------------------------------------------------------
# 3. Web3 & Decentralized Identity
# ------------------------------------------------------------------------------
# Ethereum SIWE (EIP-4361)
VITE_WEB3_DOMAIN=yourdomain.com
VITE_WEB3_STATEMENT="Sign in with Ethereum to ISA-AUTH Demo"

# ------------------------------------------------------------------------------
# 4. Next-Gen Identity & Biometrics
# ------------------------------------------------------------------------------
# World ID (https://developer.worldcoin.org/)
VITE_WORLD_APP_ID=app_staging_your_world_app_id
VITE_WORLD_ACTION=user_login
VITE_WORLD_VERIFICATION_LEVEL=orb

# Passkey (FIDO2 / WebAuthn)
VITE_PASSKEY_RP_NAME="Your Application Name"
VITE_PASSKEY_RP_ID=yourdomain.com

# ------------------------------------------------------------------------------
# 5. Security & Session Storage Settings
# ------------------------------------------------------------------------------
# Storage mode: 'memory' (Production Zero-XSS) | 'cookie' | 'sessionStorage' | 'dev_insecure_localStorage'
VITE_AUTH_STORAGE_MODE=memory
VITE_AUTH_STORAGE_PREFIX=myapp
