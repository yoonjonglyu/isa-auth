{
  "name": "isa-auth",
  "version": "0.2.1",
  "description": "Unified, framework-agnostic frontend authentication library supporting OAuth (Google, Apple, Meta, Line, Kakao, Naver), Developer (GitHub, Discord), Web3 (SIWE), Identity (World ID Orb, Passkey WebAuthn), reactive store, and RBAC guards with AI Agent skills",
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "oauth2",
    "google-auth",
    "apple-auth",
    "meta-auth",
    "kakao-auth",
    "naver-auth",
    "line-auth",
    "github-auth",
    "discord-auth",
    "web3",
    "siwe",
    "world-id",
    "worldcoin",
    "passkey",
    "webauthn",
    "fido2",
    "jwt",
    "rbac",
    "headless",
    "react",
    "vue",
    "svelte",
    "skills",
    "agent-skill"
  ],
  "author": "Isa <yunjonglyu@gmail.com> (yunjongryu)",
  "homepage": "https://github.com/yoonjonglyu/isa-auth#readme",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    ".agents",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoonjonglyu/isa-auth.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "bugs": {
    "url": "https://github.com/yoonjonglyu/isa-auth/issues"
  },
  "dependencies": {
    "isa-util": "^1.1.1"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.11.29",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  }
}
