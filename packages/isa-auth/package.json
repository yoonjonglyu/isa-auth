{
  "name": "isa-auth",
  "version": "0.1.0",
  "description": "Unified, framework-agnostic frontend authentication library supporting OAuth (Google, Kakao, Naver), Web3 (SIWE), JWT, reactive store, and RBAC guards",
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "oauth2",
    "google-auth",
    "kakao-auth",
    "naver-auth",
    "web3",
    "siwe",
    "jwt",
    "rbac",
    "headless",
    "react",
    "vue",
    "svelte"
  ],
  "author": "Isa <yunjonglyu@gmail.com> (yunjongryu)",
  "homepage": "https://github.com/yoonjonglyu/isa-auth#readme",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoonjonglyu/isa-auth.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "bugs": {
    "url": "https://github.com/yoonjonglyu/isa-auth/issues"
  },
  "dependencies": {
    "isa-util": "latest"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.11.29",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  }
}
