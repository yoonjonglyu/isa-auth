{
  "name": "isa-auth-mcp",
  "version": "0.2.2",
  "description": "Model Context Protocol (MCP) server for isa-auth, providing AI agents with RBAC permission checking, JWT inspection, Web3 SIWE verification, and auth scaffolding tools",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "isa-auth-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node ./dist/index.js",
    "type": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "isa-auth",
    "agent",
    "ai",
    "rbac",
    "siwe",
    "jwt",
    "claude-desktop"
  ],
  "author": "isa-auth contributors",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  }
}
